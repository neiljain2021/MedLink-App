<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_admin_dashboard.xml — Admin Dashboard overview screen -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ===== HEADER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2563EB"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Dashboard"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live statistics overview"
                android:textSize="13sp"
                android:textColor="#CCDAF7"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ===== STAT CARDS (2x2 grid) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="-12dp">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Users card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_admin_stat_card"
                    android:elevation="4dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤"
                        android:textSize="22sp" />
                    <TextView
                        android:id="@+id/tv_stat_users"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Users"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Requests card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_admin_stat_card"
                    android:elevation="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋"
                        android:textSize="22sp" />
                    <TextView
                        android:id="@+id/tv_stat_requests"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Requests"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Donations card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_admin_stat_card"
                    android:elevation="4dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💊"
                        android:textSize="22sp" />
                    <TextView
                        android:id="@+id/tv_stat_donations"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Donations"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- NGOs card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_admin_stat_card"
                    android:elevation="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏥"
                        android:textSize="22sp" />
                    <TextView
                        android:id="@+id/tv_stat_ngos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NGOs"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== REQUESTS STATUS CHART ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_admin_stat_card"
            android:layout_margin="16dp"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requests by Status"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <!-- PENDING bar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="@color/progress_bg"
                android:layout_marginBottom="10dp">
                <View
                    android:id="@+id/bar_pending"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="#F59E0B" />
                <TextView
                    android:id="@+id/tv_bar_pending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="4dp"
                    android:text="0" />
            </FrameLayout>

            <!-- PROCESSING bar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROCESSING"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="@color/progress_bg"
                android:layout_marginBottom="10dp">
                <View
                    android:id="@+id/bar_processing"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="#3B82F6" />
                <TextView
                    android:id="@+id/tv_bar_processing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="4dp"
                    android:text="0" />
            </FrameLayout>

            <!-- READY bar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="@color/progress_bg"
                android:layout_marginBottom="10dp">
                <View
                    android:id="@+id/bar_ready"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="#10B981" />
                <TextView
                    android:id="@+id/tv_bar_ready"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="4dp"
                    android:text="0" />
            </FrameLayout>

            <!-- REJECTED bar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REJECTED"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="@color/progress_bg">
                <View
                    android:id="@+id/bar_rejected"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="#EF4444" />
                <TextView
                    android:id="@+id/tv_bar_rejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="4dp"
                    android:text="0" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===== RECENT ACTIVITY ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Activity"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_no_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No recent activity"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
