<?xml version="1.0" encoding="utf-8"?>
<!-- item_admin_ngo.xml — Single NGO row card in admin NGOs list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_admin_stat_card"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">

    <!-- Top row: name + verified badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_ngo_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hope Care Foundation"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_ngo_verified"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="✓ Verified"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#10B981"
            android:background="@drawable/bg_status_ready"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Sub details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_ngo_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="General"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:background="@color/primary_surface"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_ngo_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Mumbai"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_ngo_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 4.5"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_ngo_edit"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="Edit"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_ngo_verify"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="Verify"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#10B981"
            android:background="@drawable/bg_status_ready"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_ngo_delete"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="Delete"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#EF4444"
            android:background="@drawable/bg_status_rejected"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
