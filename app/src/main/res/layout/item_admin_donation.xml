<?xml version="1.0" encoding="utf-8"?>
<!-- item_admin_donation.xml — Single donation row card in admin Donations list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_admin_stat_card"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">

    <!-- Top row: medicine name + status chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_donation_medicine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Amoxicillin 250mg"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_donation_status"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="VERIFYING"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#3B82F6"
            android:background="@drawable/bg_status_processing"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Details row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donor"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />
            <TextView
                android:id="@+id/tv_donor_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jane Smith"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />
            <TextView
                android:id="@+id/tv_donation_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 strips"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_don_verify"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="Verify"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#10B981"
            android:background="@drawable/bg_status_ready"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_don_reject"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="Reject"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#EF4444"
            android:background="@drawable/bg_status_rejected"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_don_delete"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="Delete"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:background="@drawable/bg_search_bar"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
